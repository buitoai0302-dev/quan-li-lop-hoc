# Backend Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file to version control!

PORT=3000

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon.tech, Supabase, or local)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ─── Authentication ───────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_USE_CRYPTO_RANDOM_64_BYTES
JWT_EXPIRES_IN=7d

# ─── URLs ────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# ─── Email / SMTP ────────────────────────────────────────────────────────────
# For development: leave empty to use Ethereal (fake SMTP, shows preview URL in console)
# For production: use Gmail App Password or a transactional email service (Resend, Mailgun)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password

# ─── Google OAuth2 ───────────────────────────────────────────────────────────
# Create at: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ─── Payment Gateways ────────────────────────────────────────────────────────
# VNPay
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# MoMo
MOMO_PARTNER_CODE=your_momo_partner_code
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_API_URL=https://test-payment.momo.vn/v2/gateway/api/create
