# Backend Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file to version control!

PORT=3000

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon.tech, Supabase, or local)
DATABASE_URL=postgresql://db_user:db_password@db.example.test:5432/eduschedule?sslmode=verify-full
# Set true only for local UI checks against a shared database.
DISABLE_BACKGROUND_JOBS=false

# ─── Authentication ───────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_USE_CRYPTO_RANDOM_64_BYTES
JWT_EXPIRES_IN=15m

# ─── URLs ────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000
# Optional comma-separated additional browser origins.
ALLOWED_ORIGINS=
# On Vercel, set VITE_API_URL to https://your-render-host/api at build time.
# FRONTEND_URL must match the exact Vercel/custom-domain origin used by browsers.

# 32-byte random hex key; keep it stable and outside the repository.
BACKUP_ENCRYPTION_KEY=CHANGE_ME_USE_CRYPTO_RANDOM_32_BYTES_HEX
LOG_LEVEL=info
# Optional mounted persistent volume path for JSON Lines. Render stdout logs are still emitted.
# LOG_FILE_PATH=/var/data/logs/eduschedule.jsonl

# ─── Email / SMTP ────────────────────────────────────────────────────────────
# For development: leave empty to use Ethereal (fake SMTP, shows preview URL in console)
# For production: use Gmail App Password or a transactional email service (Resend, Mailgun)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password

# ─── Google OAuth2 ───────────────────────────────────────────────────────────
# Create at: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ─── Payment Gateways ────────────────────────────────────────────────────────
# Enable only after sandbox callback, reconciliation and browser-flow checks pass.
ONLINE_PAYMENTS_ENABLED=false
# VNPay
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# MoMo
MOMO_PARTNER_CODE=your_momo_partner_code
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
